# ──────────────────────────────────────────────────────────────────────────────
#  Hamfield Signage — PRODUCTION secrets & host-specific values
# ──────────────────────────────────────────────────────────────────────────────
#  This is the TEMPLATE. On the server:
#
#      cp .env.prod.example .env.prod
#      chmod 600 .env.prod
#      $EDITOR .env.prod
#
#  Then pass it to every compose command with --env-file:
#
#      docker compose --env-file .env.prod \
#        -f docker-compose.yml \
#        -f infra/docker/docker-compose.prod.yml up -d --build
#
#  NOTE: this is NOT the same file as `.env.example`. That one configures a
#  LOCAL, non-Docker dev run (localhost URLs, MinIO defaults, ffmpeg paths) and
#  is copied to `.env`. Production deliberately uses a separate filename and an
#  explicit --env-file so a stray dev `.env` on the box can never leak localhost
#  values into the running stack.
#
#  `.env.prod` is git-ignored. It is the ONLY file holding production secrets —
#  the compose files reference these names and contain no credentials of their
#  own. Back it up off-box: losing it means losing the database password, which
#  means losing the database.
#
#  Syntax notes (Docker Compose env-file parsing, not a shell):
#    - No `export`, no spaces around `=`.
#    - ⚠ An unquoted `$` is treated as a variable reference and is SILENTLY
#      eaten: `PW=abc$def` arrives at the container as `abc`. This is the single
#      easiest way to corrupt a password without noticing.
#    - So: wrap any value that is not plain [A-Za-z0-9._:/-] in SINGLE quotes.
#      Single quotes disable interpolation entirely, `$` and `#` included.
#      Double quotes do NOT — they still interpolate.
#    - Generating secrets with `openssl rand -hex 32` sidesteps all of this.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Used BOTH as the postgres superuser password AND inside DATABASE_URL, so the
# two can never drift apart.
#
# ⚠ Keep it URL-safe: it is substituted into postgresql://signage:<here>@... so
#   `@ : / ? # %` would corrupt the connection string. `openssl rand -hex 32`
#   produces a safe value.
# ⚠ This password is baked into the postgres-data volume when it is FIRST
#   created. Changing it later does not change the database — see
#   docs/deployment.md §14 (P1000).
POSTGRES_PASSWORD=

# ── Application ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# The API refuses to start under NODE_ENV=production if this is left at the dev
# placeholder (apps/api/src/env.ts). Rotating it logs every dashboard user out;
# it does NOT un-pair devices — device tokens are random values stored as SHA-256
# hashes (apps/api/src/lib/tokens.ts), not JWTs.
JWT_SECRET=

# Public HTTPS base URL of the dashboard + API. Must match the domain in
# infra/docker/Caddyfile.
API_PUBLIC_URL=https://signage.example.com

# Browser origins allowed to call the API. Your dashboard origin only —
# comma-separated if you genuinely need more than one. Never a wildcard.
CORS_ORIGINS=https://signage.example.com

# Largest single upload the API will accept, in bytes. Must be <= the limits in
# infra/docker/Caddyfile (`max_size`) and infra/docker/web-nginx.conf
# (`client_max_body_size`). Default below is 1 GiB.
MAX_UPLOAD_SIZE_BYTES=1073741824

# Parallel FFmpeg transcode jobs. Raise only with CPU headroom to match.
WORKER_CONCURRENCY=2

# ── Object storage ────────────────────────────────────────────────────────────
# Model A (recommended): external S3-compatible storage, e.g. Cloudflare R2.
#   Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   Keys:     R2 → "Manage R2 API Tokens" → Object Read & Write
#   Region:   literally "auto" for R2
#   S3_PUBLIC_ENDPOINT is baked into the presigned URLs handed to browsers; for
#   R2 it is the SAME account endpoint as S3_ENDPOINT.
#
# Model B (self-hosted MinIO): keep the minio services in docker-compose.yml and
#   use S3_ENDPOINT=http://minio:9000 with a public
#   S3_PUBLIC_ENDPOINT=https://media.example.com fronted by Caddy. See
#   docs/deployment.md §6, and uncomment the `minio` block in the prod override
#   so ports 9000/9001 are not published to the internet.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=signage-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
# "true" for R2 and MinIO; most virtual-hosted providers (AWS S3) want "false".
S3_FORCE_PATH_STYLE=true

# ── First-run superadmin ──────────────────────────────────────────────────────
# Created once, on the first API start, only if no superadmin exists. Never
# overwritten, and the password is never logged. Password must be >= 12 chars.
# Change the password after first login, then you may blank these out.
# If you leave them empty, create the account afterwards with:
#   docker compose exec api node apps/api/dist/cli/create-superadmin.js \
#     admin@example.com 'StrongPass12+' 'Platform Admin'
INITIAL_SUPERADMIN_EMAIL=
INITIAL_SUPERADMIN_PASSWORD=
INITIAL_SUPERADMIN_NAME=
