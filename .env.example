# ----- Database -----
DATABASE_URL=postgresql://signage:signage@localhost:5432/signage

# ----- Redis -----
REDIS_URL=redis://localhost:6379

# ----- API server -----
API_HOST=0.0.0.0
API_PORT=4000
# Public base URL of the API as reachable by devices and browsers
API_PUBLIC_URL=http://localhost:4000
# Secret used to sign user JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
# Access token lifetime
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed dashboard origins
CORS_ORIGINS=http://localhost:5173

# ----- Object storage (S3-compatible, MinIO in dev) -----
S3_ENDPOINT=http://localhost:9000
# Endpoint used inside presigned URLs handed to browsers/devices.
# In dev this must be reachable from the host; in prod use your public S3/CDN endpoint.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=signage-media
S3_ACCESS_KEY=signage
S3_SECRET_KEY=signage-secret
S3_FORCE_PATH_STYLE=true

# ----- Uploads / media -----
# Maximum upload size in bytes (default 1 GiB)
MAX_UPLOAD_SIZE_BYTES=1073741824
# Maximum output video height for transcoding (1080 keeps RPi4/ODROID-C4 happy)
MAX_VIDEO_HEIGHT=1080
# Maximum output frame rate. 30 is safe for ARM SBC hardware decoders; raise only
# if your players are all beefy (1080p50/60 needs a strong decoder).
MAX_VIDEO_FPS=30
# Target video bitrate for the processed variant
VIDEO_BITRATE_KBPS=6000
# Bitrate for the low-bandwidth fallback variant
FALLBACK_VIDEO_BITRATE_KBPS=2000
# Set to "false" to skip creating fallback variants
CREATE_FALLBACK_VARIANT=true
# Paths to ffmpeg/ffprobe binaries (leave as-is if on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ----- Superadmin bootstrap -----
# When set (all three) and no superadmin exists yet, the API creates this
# account on startup. Existing superadmins are never overwritten and the
# password is never logged. Minimum 12 characters.
INITIAL_SUPERADMIN_EMAIL=
INITIAL_SUPERADMIN_PASSWORD=
INITIAL_SUPERADMIN_NAME=

# ----- Pairing -----
# Pairing code lifetime in minutes
PAIRING_CODE_TTL_MINUTES=15

# ----- Worker -----
WORKER_CONCURRENCY=2

# ----- Telemetry retention (worker) -----
# Nothing pruned these tables before; at 100 devices they grow by roughly 1.1M
# rows/day. THIS DELETES ROWS. It stays a dry run until you set false, and it
# refuses to delete unless infra/backup/backup.sh has recorded a recent success.
RETENTION_ENABLED=true
RETENTION_DRY_RUN=true
# 03:00 UTC, half an hour before the 03:30 backup, so a destructive run is always
# followed by a fresh backup rather than preceding one by a whole day.
RETENTION_CRON=0 3 * * *
RETENTION_HEARTBEAT_DAYS=14
RETENTION_DEVICE_LOG_DAYS=30
# Longer on purpose: playback_events back the proof-of-play and play-count
# features, so pruning them changes numbers customers may already have seen.
RETENTION_PLAYBACK_EVENT_DAYS=90
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_BATCHES=40
RETENTION_REQUIRE_BACKUP_WITHIN_HOURS=36

# ----- Alerting (worker) -----
# Disabled until a destination is set. An alerting system nobody receives is worse
# than none, because it looks like coverage.
# ntfy: create a topic (a hard-to-guess name IS the access control on ntfy.sh) and
# subscribe on your phone. Self-hosted works the same way.
ALERT_NTFY_URL=
# Only for a self-hosted ntfy with auth enabled.
ALERT_NTFY_TOKEN=
ALERT_CRON=*/5 * * * *
# The highest-value alert: an emergency override has no auto-expiry, so a
# forgotten one blanks a customer's screens indefinitely.
ALERT_EMERGENCY_HOURS=4
ALERT_OFFLINE_MINUTES=15
ALERT_QUEUE_WAITING=20
# A firing alert repeats at most this often.
ALERT_REPEAT_HOURS=6

# ----- Web dashboard (Vite) -----
VITE_API_URL=http://localhost:4000

# ----- Mock device (apps/mock-device) -----
MOCK_DEVICE_BACKEND_URL=http://localhost:4000
MOCK_DEVICE_PAIRING_CODE=
MOCK_DEVICE_PORT=8080
