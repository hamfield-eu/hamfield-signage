{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"],
  // Tests are not part of the shipped image, and the integration harness uses
  // ESM-only syntax (`import.meta`) that cannot compile to the CommonJS output
  // this build produces. They are typechecked by tsconfig.test.json instead.
  "exclude": ["src/**/*.test.ts", "src/test"]
}
